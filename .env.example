# NEXO · configuración local de ejemplo (sin secretos reales).
# Copia este archivo como ".env" o genera uno con:  python scripts/gen_env.py
NEXO_INTERNAL_TOKEN=CAMBIA_ESTE_TOKEN_POR_UNO_ALEATORIO
NEXO_PY_URL=http://127.0.0.1:8001
NEXO_MYSQL_HOST=127.0.0.1
NEXO_MYSQL_PORT=3306
NEXO_RO_USER=nexo_ro
NEXO_RO_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
NEXO_APP_USER=nexo_app
NEXO_APP_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
# NEXO · IA (proveedor del modelo). Sin clave se usa el proveedor de prueba.
# NEXO_AI_PROVIDER: stub (prueba) | openai (real, compatible con /chat/completions)
# Funciona con OpenAI o con Gemini (gratuito con límites) cambiando BASE_URL y MODEL.
NEXO_AI_PROVIDER=stub
NEXO_AI_MODEL=gpt-4o-mini
NEXO_AI_BASE_URL=https://api.openai.com/v1
# Ejemplo Gemini gratis: BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# y MODEL=gemini-3.8-flash (clave gratis en https://aistudio.google.com/apikey)
NEXO_AI_API_KEY=
# Límites conservadores del trabajo agentic
NEXO_AI_TIMEOUT_S=180
NEXO_AI_MAX_STEPS=10
NEXO_AI_MAX_TOOL_CALLS=20
NEXO_AI_MAX_RETRIES=2
NEXO_AI_JOB_TIMEOUT_S=600
NEXO_AI_MAX_ROWS_TOOL=200
NEXO_AI_REDACT=1
